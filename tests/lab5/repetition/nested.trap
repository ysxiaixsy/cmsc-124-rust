// a spin inside a spin: the inner loop starts over on every pass of the outer one
hold row = 1;
spin (row <= 2) {
  hold col = 1;
  spin (col <= 3) {
    spittin row * 10 + col; // expect: 11
                            // expect: 12
                            // expect: 13
                            // expect: 21
                            // expect: 22
                            // expect: 23
    col = col + 1;
  }
  row = row + 1;
}
